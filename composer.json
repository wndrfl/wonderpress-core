{
    "name": "wndrfl/wonderpress-core",
    "description": "A toolkit layer for awesome WordPress development and management.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Wonderful",
            "homepage": "https://wonderful.io"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "autoload": {
        "files": [
            "wonderpress-core/init.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check-tooling": [
            "php -r \"require 'vendor/autoload.php'; echo 'BOOTSTRAP_OK';\" | grep -q BOOTSTRAP_OK",
            "./vendor/bin/phpcs -i | grep -q WordPress"
        ],
        "lint": "./vendor/bin/phpcs -p -v .",
        "lint-fix": "./vendor/bin/phpcbf -p -v ."
    }
}
